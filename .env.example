SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Google OAuth web application credentials - server only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
